# 可选的调用方环境变量示例。emergency_rag 不读取 .env 或环境变量。
# 应用自行读取并创建 SDK，超时和重试直接传给 SDK 构造函数。
RAG_EMBEDDING__BASE_URL=https://your-embedding-service.example/v1
RAG_EMBEDDING__MODEL=your-embedding-model
RAG_EMBEDDING__API_KEY=
RAG_EMBEDDING__TIMEOUT=60
RAG_EMBEDDING__MAX_RETRIES=2

RAG_RERANK__BASE_URL=https://api.zeroentropy.dev/v1
RAG_RERANK__MODEL=your-zeroentropy-model
RAG_RERANK__API_KEY=
RAG_RERANK__TIMEOUT=60
RAG_RERANK__MAX_RETRIES=2

# 独立 ChatLLM 的可选配置。
# RAG_CHAT__BASE_URL=https://your-chat-service.example/v1
# RAG_CHAT__MODEL=your-chat-model
# RAG_CHAT__API_KEY=
