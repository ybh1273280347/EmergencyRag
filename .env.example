# 模型模块首次使用时读取以下进程环境变量并缓存实例。
# 不自动读取 .env；应用在首次 load_pipeline 或 get_chat_client 之前自行加载或设置。
RAG_EMBEDDING_BASE_URL=https://your-embedding-service.example/v1
RAG_EMBEDDING_MODEL=your-embedding-model
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_TIMEOUT=60
RAG_EMBEDDING_MAX_RETRIES=2

# ZeroEntropy 专属配置；其他重排服务使用各自模块的环境变量。
ZEROENTROPY_URL=https://api.zeroentropy.dev/v1
ZEROENTROPY_MODEL=your-zeroentropy-model
ZEROENTROPY_API_KEY=
ZEROENTROPY_TIMEOUT=60
ZEROENTROPY_MAX_RETRIES=2

# 作答客户端的可选配置，首次 get_chat_client 时读取。
# RAG_CHAT_BASE_URL=https://your-chat-service.example/v1
# RAG_CHAT_MODEL=your-chat-model
# RAG_CHAT_API_KEY=
# RAG_CHAT_TIMEOUT=60
# RAG_CHAT_MAX_RETRIES=2
