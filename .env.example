# 复制为 .env 并填写密钥；settings.py 自动加载，已有环境变量优先。
# 模型名、URL、超时和重试在 src/emergency_rag/settings.py 的 Settings 中配置。
RAG_EMBEDDING_API_KEY=
RAG_EMBEDDING_MODEL=
RAG_EMBEDDING_BASE_URL=

# Qwen 云端重排默认复用 Embedding 的密钥和地址；独立部署时再填写覆盖项。
# QWEN_RERANKER_API_KEY=
# QWEN_RERANKER_MODEL=qwen3-reranker-4b
# QWEN_RERANKER_BASE_URL=

# 实验需要模型作答时填写。
# RAG_CHAT_API_KEY=
# RAG_CHAT_MODEL=
# RAG_CHAT_BASE_URL=

# 使用 TypeSafe / Jev 做选择题时填写；模型名在 Settings.typesafe_model 配置。
